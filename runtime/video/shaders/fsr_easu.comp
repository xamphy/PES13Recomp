#version 450
// FSR 1 EASU (edge-adaptive spatial upsampling): the game frame -> the on-screen size (presenter.cpp).
// AMD FidelityFX FSR 1, thirdparty/fsr1 (MIT). 64 threads write a 16x16 output block.
// Compile: glslc -O --target-env=vulkan1.0 -I ../../../thirdparty/fsr1 -mfmt=c fsr_easu.comp -o fsr_easu.spv.h
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform sampler2D inputTex;           // the game frame, linear filtering
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImg;
layout(push_constant) uniform Constants { uvec4 con0, con1, con2, con3; uvec2 outputSize; } pc;

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(inputTex, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(inputTex, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(inputTex, p, 2); }
#include "ffx_fsr1.h"

void Filter(AU2 pos)
{
    if (any(greaterThanEqual(pos, pc.outputSize))) return;
    AF3 c;
    FsrEasuF(c, pos, pc.con0, pc.con1, pc.con2, pc.con3);
    imageStore(outputImg, ASU2(pos), AF4(c, 1.0));
}

void main()
{
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    Filter(p);
    p.x += 8u;
    Filter(p);
    p.y += 8u;
    Filter(p);
    p.x -= 8u;
    Filter(p);
}
