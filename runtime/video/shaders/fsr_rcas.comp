#version 450
// FSR 1 RCAS (robust contrast-adaptive sharpening) on the EASU output, same size (presenter.cpp).
// AMD FidelityFX FSR 1, thirdparty/fsr1 (MIT). 64 threads write a 16x16 output block.
// Compile: glslc -O --target-env=vulkan1.0 -I ../../../thirdparty/fsr1 -mfmt=c fsr_rcas.comp -o fsr_rcas.spv.h
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform sampler2D inputTex;           // EASU output
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImg;
layout(push_constant) uniform Constants { uvec4 con0, con1, con2, con3; uvec2 outputSize; } pc; // con0: RCAS

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(inputTex, p, 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"

void Filter(AU2 pos)
{
    if (any(greaterThanEqual(pos, pc.outputSize))) return;
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, pos, pc.con0);
    imageStore(outputImg, ASU2(pos), AF4(c, 1.0));
}

void main()
{
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    Filter(p);
    p.x += 8u;
    Filter(p);
    p.y += 8u;
    Filter(p);
    p.x -= 8u;
    Filter(p);
}
