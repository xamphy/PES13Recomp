#version 450
// EDRAM tile transfer depth/stencil -> 32bpp color: the guest aliases EDRAM holding a D24S8 /
// D24FS8 depth buffer as an 8:8:8:8 color render target (to read depth without a depth
// resolve). Each pixel becomes the raw EDRAM word (depth24 << 8 | stencil) as the guest reads it through an
// 8:8:8:8 target, red in the low byte (Xenos/Xenia layout): red = stencil, green = depth 7:0,
// blue = depth 15:8, alpha = depth 23:16. D3D clears a color target through a depth/stencil target
// at the same EDRAM base (PES number tiles: word 0x00F0F0F0 = color F0 F0 F0 00), so this order
// is observable. pc.oldOrder = 1: the earlier order (red = depth 23:16 ... alpha = stencil).
// Compile: glslc -O --target-env=vulkan1.0 -mfmt=c depth_to_color.comp -o depth_to_color.spv.h
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;      // depth aspect
layout(set = 0, binding = 1) uniform usampler2D stencilTex;   // stencil aspect
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dst;
layout(set = 0, binding = 3, std430) readonly buffer Tiles { uvec4 tiles[]; }; // src xy, dst xy (pixels)

layout(push_constant) uniform Params
{
    uvec2 tileSize;    // destination tile, pixels
    uint depthFloat;   // 1 = D24FS8 (20e4 float depth)
    uint oldOrder;   // 1 = earlier byte order (A/B, PES_D2C_ORDER=old)
    uvec2 srcTileSize; // source tile, pixels (another MSAA mode: nearest sample)
} pc;

// Xenia's xenos::Float32To20e4 (round to nearest even).
uint Float32To20e4(float f)
{
    if (!(f > 0.0)) return 0u;
    uint u = floatBitsToUint(f);
    if (u >= 0x3FFFFFF8u) return 0xFFFFFFu;
    if (u < 0x38800000u)
    {
        uint shift = min(113u - (u >> 23), 24u);
        u = (0x800000u | (u & 0x7FFFFFu)) >> shift;
    }
    else
        u += 0xC8000000u;
    u += 3u + ((u >> 3) & 1u);
    return (u >> 3) & 0xFFFFFFu;
}

void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.tileSize.x || p.y >= pc.tileSize.y) return;
    uvec4 t = tiles[gl_WorkGroupID.z];
    ivec2 s = ivec2(t.xy + p * pc.srcTileSize / pc.tileSize);
    ivec2 d = ivec2(t.zw + p);
    float z = texelFetch(depthTex, s, 0).r;
    uint stencil = texelFetch(stencilTex, s, 0).r & 0xFFu;
    uint z24 = pc.depthFloat != 0u ? Float32To20e4(z) : min(uint(clamp(z, 0.0, 1.0) * 16777215.0 + 0.5), 0xFFFFFFu); // 1.0 * 16777215 + 0.5 rounds to 2^24 in float
    uint word = (z24 << 8) | stencil; // the EDRAM word
    if (pc.oldOrder != 0u)
        word = (z24 >> 16) | (((z24 >> 8) & 0xFFu) << 8) | ((z24 & 0xFFu) << 16) | (stencil << 24);
    imageStore(dst, d, unpackUnorm4x8(word));
}
